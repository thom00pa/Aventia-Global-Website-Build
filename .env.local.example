# ─────────────────────────────────────────────────────────────
# Aventia Global — Environment Variables Reference
# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored and MUST NOT be committed.
# ─────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://aventiaglobal.com
NEXT_PUBLIC_APP_ENV=production

# ── WhatsApp (Energy page floating button + CTAs) ─────────────
# Format: +1XXXXXXXXXX (include country code)
NEXT_PUBLIC_WHATSAPP_NUMBER=+12145550000

# ── Resend (transactional email) ──────────────────────────────
# Get your API key at https://resend.com
# Required to send email from API routes.
# Without this key, submissions are logged to console only.
RESEND_API_KEY=re_YOUR_KEY_HERE

# ── Notification email addresses (server-only) ───────────────
# These receive internal notifications for each form submission.
ENERGY_NOTIFICATION_EMAIL=energy@aventiaglobal.com
CONTACT_NOTIFICATION_EMAIL=hello@aventiaglobal.com
WAITLIST_NOTIFICATION_EMAIL=hello@aventiaglobal.com

# ── Analytics ────────────────────────────────────────────────
# Google Tag Manager container ID
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# Google Analytics Measurement ID (if using GA4 directly)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Vercel (auto-set by Vercel — do not set manually) ────────
# VERCEL_URL is auto-injected by Vercel in deployment.
# VERCEL_ENV is 'production', 'preview', or 'development'.
